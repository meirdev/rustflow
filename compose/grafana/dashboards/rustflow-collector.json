      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source_ip, type) (rate(flows_processed_total[$__rate_interval]))",
          "legendFormat": "{{source_ip}} {{type}}"
        }
      ]
    },
