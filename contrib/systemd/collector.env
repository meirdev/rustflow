# Arguments for `rustflow collect`, read by rustflow-collector.service.
# Install to /etc/rustflow/collector.env and edit to taste.
#
# The output directory /var/lib/rustflow is created by systemd
# (StateDirectory=) and owned by the rustflow user.

# NetFlow v5/v9 + IPFIX on UDP 9995, normalized flows as 5-minute Parquet
# files partitioned by day/hour/5-minute bucket, metrics on localhost:9090.
RUSTFLOW_ARGS=-t netflow -p 9995 -f common -s parquet -o /var/lib/rustflow -i 5m -l 3 --metrics-host 127.0.0.1 --metrics-port 9090

# sFlow instead:
#RUSTFLOW_ARGS=-t sflow -p 6343 -f common -s parquet -o /var/lib/rustflow -i 5m -l 3 --metrics-host 127.0.0.1 --metrics-port 9090

# Hourly NDJSON files with GeoIP enrichment:
#RUSTFLOW_ARGS=-t netflow -p 9995 -f common -s ndjson -o /var/lib/rustflow -i 1h -l 1 --enrich "type=prefix_lookup,source=/etc/rustflow/GeoLite2-Country.mmdb,key=dst_addr,fields=country.iso_code:dst_country,reload=1h"
